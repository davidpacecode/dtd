<p style="color: green"><%= notice %></p>

<% content_for :title, "Tasks" %>

<h1>Tasks</h1>

<div id="tasks">
  <table>
    <caption>Eat that frog!</caption>
    <thead>
      <th>Due Date</th>
      <th>Title</th>
      <th>Description</th>
      <th>Project</th>
    </thead>
    <tbody>
      <% @tasks.order(:due_date).each do |task| %>
        <tr>
          <td><%= task.due_date.to_fs(:long) %></td>
          <td><%= link_to task.title, task %></td>
          <td><%= task.description %></td>
          <td><%= task.project.name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New task", new_task_path %>
<br>
<%= link_to "New project", new_project_path %>
