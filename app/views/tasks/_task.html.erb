<div id="<%= dom_id task %>">
  <div>
    <strong>Title:</strong>
    <%= task.title %>
  </div>

  <div>
    <strong>Due date:</strong>
    <%= task.due_date %>
  </div>

  <div>
    <strong>Project:</strong>
    <%= task.project&.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= task.description %>
  </div>
</div>
