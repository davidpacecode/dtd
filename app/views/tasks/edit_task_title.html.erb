<%= turbo_frame_tag "edit_task_title_#{@task.id}" do %>
  <%= form_with model: @task do |form| %>
    <div class="wa-cluster">
      <%= form.text_field :title,
          value: @task.title,
          class: "wa-input",
          placeholder: "Task title" %>
      <%= form.submit "Save", class: "wa-button wa-button--primary wa-size-s" %>
      <%= link_to "Cancel", tasks_path,
        data: { turbo_frame: "edit_task_title_#{@task.id}" }, 
          class: "wa-button wa-size-s" %>
    </div>
  <% end %>
<% end %>
