<p style="color: green"><%= notice %></p>

<% content_for :title, "Projects" %>

<h1>Projects</h1>

<div class="project-table" id="projects">
  <div class="wa-heading-m">Name</div>
  <div class="wa-heading-m">Description</div>
  <div class="wa-heading-m"></div>

    <% @projects.each do |project| %>
      <div>
        <%= link_to project.name, project %>
      </div>
      <div>
        <%= project.description %>
      </div>
      <div>
        <%= link_to "View", project %>
        <%= link_to "Edit", edit_project_path(project) %>
        <%= link_to "Delete", project, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      </div>
    <% end %>
  </div>
</div>

<%= link_to "New project", new_project_path %>
